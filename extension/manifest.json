{
  "manifest_version": 2,
  "name": "MailChat for Thunderbird",
  "version": "1.4.1",
  "description": "Connect Thunderbird to local Codex chats. Drafts by default; optional autonomous sending.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mailchat-for-thunderbird@andrea199.github.io",
      "strict_min_version": "153.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "storage",
    "http://127.0.0.1/*",
    "compose",
    "compose.save"
  ],
  "background": {
    "scripts": [
      "policy.js",
      "appearance.js",
      "attachments.js",
      "core.js",
      "history.js",
      "replies.js",
      "outbound.js",
      "drafts.js",
      "background.js"
    ],
    "persistent": true
  },
  "options_ui": {
    "page": "status.html",
    "open_in_tab": true
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:37629",
  "author": "Andrea Detry",
  "optional_permissions": [
    "compose.send"
  ],
  "homepage_url": "https://github.com/andrea199/mailchat-for-thunderbird",
  "icons": {
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  }
}
